      "LinkoLTE": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Linko_Skilldes.Linko_Skilldes",
          "Key": "GA_Linko_LinkoLTE_name",
          "SourceString": "「同频合击」",
          "LocalizedString": "「同频合击」"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Linko_Skilldes.Linko_Skilldes",
          "Key": "GA_Linko_LinkoLTE_des",
          "SourceString": "「同频合击」是一种特殊的援护技，造成的伤害视为追加攻击伤害，伤害属性为发起「同频合击」角色的属性，如果由小贞发起「同频合击」，则伤害为灵属性。\r\n通常情况下，「同频合击」不会触发异能环合，且伤害受灵可面板和援护技技能等级影响。",
          "LocalizedString": "「同频合击」是一种特殊的援护技，造成的伤害视为追加攻击伤害，伤害属性为发起「同频合击」角色的属性，如果由小贞发起「同频合击」，则伤害为灵属性。\r\n通常情况下，「同频合击」不会触发异能环合，且伤害受灵可面板和援护技技能等级影响。"
        }
      },
      "LinkoXiaozhenMark": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Linko_Skilldes.Linko_Skilldes",
          "Key": "GA_Linko_xiaozhenMark_name",
          "SourceString": "「小鬼打这里！」",
          "LocalizedString": "「小鬼打这里！」"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Linko_Skilldes.Linko_Skilldes",
          "Key": "GA_Linko_xiaozhenMark_des",
          "SourceString": "「小鬼打这里！」是一种施加给敌方目标的标记，队伍前台角色使用变轨技能命中目标时，将消耗该标记，并触发灵可的「同频合击」攻击目标，同时积攒「谐频」点数与环合值。场上同时最多存在1个「小鬼打这里！」标记，标记可持续10秒。",
          "LocalizedString": "「小鬼打这里！」是一种施加给敌方目标的标记，队伍前台角色使用变轨技能命中目标时，将消耗该标记，并触发灵可的「同频合击」攻击目标，同时积攒「谐频」点数与环合值。场上同时最多存在1个「小鬼打这里！」标记，标记可持续10秒。"
        }
      }
