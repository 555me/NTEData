      "ChiichanRes1": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes1_name",
          "SourceString": "金谷",
          "LocalizedString": "金谷"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes1_des",
          "SourceString": "小吱入队后自身持有的特殊战斗资源，通过释放「普通攻击：失乡剑术」、「普通攻击：荒谷」、「普通攻击：丰玉」、「极限闪避：明斯基时刻」、利息均可获得「金谷」。",
          "LocalizedString": "小吱入队后自身持有的特殊战斗资源，通过释放「普通攻击：失乡剑术」、「普通攻击：荒谷」、「普通攻击：丰玉」、「极限闪避：明斯基时刻」、利息均可获得「金谷」。"
        }
      },
      "ChiichanRes2": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes2_name",
          "SourceString": "盈余",
          "LocalizedString": "盈余"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes2_des",
          "SourceString": "小吱持有「金谷」时，即处于该状态。",
          "LocalizedString": "小吱持有「金谷」时，即处于该状态。"
        }
      },
      "ChiichanRes3": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes3_name",
          "SourceString": "负债",
          "LocalizedString": "负债"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes3_des",
          "SourceString": "小吱不持有「金谷」时，进入该状态。",
          "LocalizedString": "小吱不持有「金谷」时，进入该状态。"
        }
      },
      "ChiichanRes4": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes4_name",
          "SourceString": "金谷贷款",
          "LocalizedString": "金谷贷款"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes4_des",
          "SourceString": "小吱消耗完全部「金谷」后持有的特殊战斗资源，可通过消耗「金谷贷款」造成伤害。",
          "LocalizedString": "小吱消耗完全部「金谷」后持有的特殊战斗资源，可通过消耗「金谷贷款」造成伤害。"
        }
      },
      "ChiichanRes5": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes5_name",
          "SourceString": "金谷K线",
          "LocalizedString": "金谷K线"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes5_des",
          "SourceString": "进入「金谷市场」后，界面上将出现波动的「金谷」K线图，显示当前「金谷」价格，可预见3.5秒内的「金谷」价格走势，每0.5秒生成一次。\r\nK线图存在期间，生成的「金谷」价格将基于上次的价格在[﹣50%,﹢50%]范围内随机波动。",
          "LocalizedString": "进入「金谷市场」后，界面上将出现波动的「金谷」K线图，显示当前「金谷」价格，可预见3.5秒内的「金谷」价格走势，每0.5秒生成一次。\r\nK线图存在期间，生成的「金谷」价格将基于上次的价格在[﹣50%,﹢50%]范围内随机波动。"
        }
      },
      "ChiichanRes6": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes6_name",
          "SourceString": "谷价结算",
          "LocalizedString": "谷价结算"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Chiichan_SkillDes.Chiichan_SkillDes",
          "Key": "ChiichanRes6_des",
          "SourceString": "进入「金谷市场」后，点按变轨技能可依据当前「金谷K线」所示的「金谷」价格进行结算，并获得对应「金谷」。长按变轨技能时，将先结算当前「金谷」，再依据技能所消耗的「金谷」造成额外光属性异能伤害。\r\n每次点按变轨技能时均可进行「谷价结算」；长按变轨技能时，只进行1次「谷价结算」。",
          "LocalizedString": "进入「金谷市场」后，点按变轨技能可依据当前「金谷K线」所示的「金谷」价格进行结算，并获得对应「金谷」。长按变轨技能时，将先结算当前「金谷」，再依据技能所消耗的「金谷」造成额外光属性异能伤害。\r\n每次点按变轨技能时均可进行「谷价结算」；长按变轨技能时，只进行1次「谷价结算」。"
        }
      },
