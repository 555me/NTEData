      "ShinkuRage": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Shinku_SkillDes.Shinku_SkillDes",
          "Key": "ShinkuRage_name",
          "SourceString": "升腾之赤",
          "LocalizedString": "升腾之赤"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Shinku_SkillDes.Shinku_SkillDes",
          "Key": "ShinkuRage_des",
          "SourceString": "真红消耗所有「桀骜斗志」进入的特殊状态，期间「普通攻击：特种格斗术」替换为「普通攻击：惊骇急袭」，「变轨技能：高速突破」替换为「变轨技能：天降赤锋」，造成的伤害和抗打断能力提升，移动能力大幅提升，持续<NumGreen>13</>秒，切换角色后退出。",
          "LocalizedString": "真红消耗所有「桀骜斗志」进入的特殊状态，期间「普通攻击：特种格斗术」替换为「普通攻击：惊骇急袭」，「变轨技能：高速突破」替换为「变轨技能：天降赤锋」，造成的伤害和抗打断能力提升，移动能力大幅提升，持续<NumGreen>13</>秒，切换角色后退出。"
        }
      },
