      "SagiriEat": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Sagiri_SkillDes.Sagiri_SkillDes",
          "Key": "Sagiri_Eat_name",
          "SourceString": "摄食模式",
          "LocalizedString": "摄食模式"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Sagiri_SkillDes.Sagiri_SkillDes",
          "Key": "Sagiri_Eat_des",
          "SourceString": "早雾可坐在鬼郎丸上持续移动，期间弱小的敌人会被吸至身前并吞噬，每次吞噬有消化时间。",
          "LocalizedString": "早雾可坐在鬼郎丸上持续移动，期间弱小的敌人会被吸至身前并吞噬，每次吞噬有消化时间。"
        }
      },
      "Lacrimosa_dot": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Lacrimosa_SkillDes.Lacrimosa_SkillDes",
          "Key": "GA_Lacrimosa_dot_name",
          "SourceString": "噩梦",
          "LocalizedString": "噩梦"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Lacrimosa_SkillDes.Lacrimosa_SkillDes",
          "Key": "GA_Lacrimosa_dot_des",
          "SourceString": "每秒对目标造成1次<An>暗属性异能伤害</>，持续3秒。\r\n当目标受到治疗时，移除1层「噩梦」。",
          "LocalizedString": "每秒对目标造成1次<An>暗属性异能伤害</>，持续3秒。\r\n当目标受到治疗时，移除1层「噩梦」。"
        }
      },
      "DaffodillInsight": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Daffodill_SkillDes.Daffodill_SkillDes",
          "Key": "Daffodill_DongCha_name",
          "SourceString": "洞察",
          "LocalizedString": "洞察"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Daffodill_SkillDes.Daffodill_SkillDes",
          "Key": "Daffodill_DongCha_des",
          "SourceString": "如果目标在「洞察」效果期间进入倾陷，将额外受到一次达芙蒂尔造成的倾陷伤害，并被移除「洞察」效果。",
          "LocalizedString": "如果目标在「洞察」效果期间进入倾陷，将额外受到一次达芙蒂尔造成的倾陷伤害，并被移除「洞察」效果。"
        }
      },
      "DaffodillQTE": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Daffodill_SkillDes.Daffodill_SkillDes",
          "Key": "Daffodill_ZhiYuan_name",
          "SourceString": "幻影移行",
          "LocalizedString": "幻影移行"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Daffodill_SkillDes.Daffodill_SkillDes",
          "Key": "Daffodill_ZhiYuan_des",
          "SourceString": "战斗中且存在目标时，从其他角色切换至达芙蒂尔时，达芙蒂尔先行释放「幻影移行」。如果「幻影移行」成功承轨反击目标，可造成高额伤害和倾陷值并立刻为「极轨终结：见此终幕」蓄满充能。如果切换至达芙蒂尔时存在「援护技：交仞」，会先行释放「援护技：交仞」，后自动释放「幻影移行」，此时「援护技：交仞」承轨反击成功视为「幻影移行」承轨反击成功。",
          "LocalizedString": "战斗中且存在目标时，从其他角色切换至达芙蒂尔时，达芙蒂尔先行释放「幻影移行」。如果「幻影移行」成功承轨反击目标，可造成高额伤害和倾陷值并立刻为「极轨终结：见此终幕」蓄满充能。如果切换至达芙蒂尔时存在「援护技：交仞」，会先行释放「援护技：交仞」，后自动释放「幻影移行」，此时「援护技：交仞」承轨反击成功视为「幻影移行」承轨反击成功。"
        }
      },
      "KuharaAttachment": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Kuhara_SkillDes.Kuhara_SkillDes",
          "Key": "KuharaAttachment_name",
          "SourceString": "致命玫约",
          "LocalizedString": "致命玫约"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Kuhara_SkillDes.Kuhara_SkillDes",
          "Key": "KuharaAttachment_des",
          "SourceString": "属于附着物。存在期间，会持续吞噬目标生命力，经过 <NumGreen>5</> 秒后，强制目标步入可发起「致约清算」的阶段，该阶段持续<NumGreen>25</>秒。",
          "LocalizedString": "属于附着物。存在期间，会持续吞噬目标生命力，经过 <NumGreen>5</> 秒后，强制目标步入可发起「致约清算」的阶段，该阶段持续<NumGreen>25</>秒。"
        }
      },
      "KuharaPowerBullet": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Kuhara_SkillDes.Kuhara_SkillDes",
          "Key": "KuharaPowerBullet_name",
          "SourceString": "玫约子弹",
          "LocalizedString": "玫约子弹"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Kuhara_SkillDes.Kuhara_SkillDes",
          "Key": "KuharaPowerBullet_des",
          "SourceString": "九原释放「普通攻击：秘密成型时」、「变轨技能：情报猎手」、「极限反击：局势逆转」和「援护技：秘闻锁定」可获得，通过触发「普通攻击：信息导向型」发射使用，对缔结「致命玫约」的目标发起「致约清算」；\r\n若目标当前不可清算，则使「致命玫约」加快进入可清算阶段。",
          "LocalizedString": "九原释放「普通攻击：秘密成型时」、「变轨技能：情报猎手」、「极限反击：局势逆转」和「援护技：秘闻锁定」可获得，通过触发「普通攻击：信息导向型」发射使用，对缔结「致命玫约」的目标发起「致约清算」；\r\n若目标当前不可清算，则使「致命玫约」加快进入可清算阶段。"
        }
      },
      "KuharaBudBoom": {
        "Title": {
          "TableId": "/Game/Text/PlayerSkillDes/Kuhara_SkillDes.Kuhara_SkillDes",
          "Key": "KuharaBudBoom_name",
          "SourceString": "致约清算",
          "LocalizedString": "致约清算"
        },
        "Explanation": {
          "TableId": "/Game/Text/PlayerSkillDes/Kuhara_SkillDes.Kuhara_SkillDes",
          "Key": "KuharaBudBoom_des",
          "SourceString": "「致命玫约」进入可清算阶段后，被「玫约子弹」或「极轨终结：终局清账」最后一段伤害命中后触发，造成高额附着类<Ling>灵属性异能伤害</>，由「极轨终结：终局清账」触发造成的清算伤害将大幅提升且使九原获得大量终结能量；\r\n若「致命玫约」持续时间内未被触发，「致约清算」会在超时后自动清算，对目标造成伤害附着类<Ling>灵属性异能伤害</>。",
          "LocalizedString": "「致命玫约」进入可清算阶段后，被「玫约子弹」或「极轨终结：终局清账」最后一段伤害命中后触发，造成高额附着类<Ling>灵属性异能伤害</>，由「极轨终结：终局清账」触发造成的清算伤害将大幅提升且使九原获得大量终结能量；\r\n若「致命玫约」持续时间内未被触发，「致约清算」会在超时后自动清算，对目标造成伤害附着类<Ling>灵属性异能伤害</>。"
        }
      },
